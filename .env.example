# Azure OpenAI (used when AZURE_OPENAI_ENDPOINT is set)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2025-04-01-preview
AZURE_EMBEDDING_DEPLOYMENT=text-embedding-3-small
# Deployment that makes the decision. Use a non-reasoning model to get logprobs.
JUDGE_MODEL=gpt-4.1-mini
# Deployment LightRAG uses for entity and relation extraction while indexing
INDEX_MODEL=gpt-4.1-mini

# Azure AI Speech, for the audio track of videos (the free F0 tier is enough).
# Without it, videos are reviewed from their frames only.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=koreacentral
# SPEECH_LANGUAGE=en-US

# Or the public OpenAI API: leave the Azure block empty and set
# OPENAI_API_KEY=

# Routing thresholds (defaults shown)
# MIN_VERDICT_PROBABILITY=0.85
# MIN_AGREEMENT=0.6
# MIN_GROUNDEDNESS=0.75
# CONSISTENCY_SAMPLES=5

# Bearer token the agent API expects; Open WebUI is given the same value
# AGENT_API_KEY=local-dev-key
